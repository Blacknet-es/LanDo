# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=lando
POSTGRES_PASSWORD=lando_secret
POSTGRES_DB=lando_db
DATABASE_URL=postgresql://lando:lando_secret@db:5432/lando_db

# ─── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# ─── API ─────────────────────────────────────────────────────────────────────
# Host-side port exposed by Docker (8001 avoids conflicts with other local services)
API_PORT=8001
ENVIRONMENT=development
SECRET_KEY=dev-only-secret-key-change-in-production
# Generate with Fernet.generate_key(); required when ENVIRONMENT=production.
LLM_SECRETS_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
WEBHOOK_SECRET=replace-with-a-long-random-secret
N8N_WEBHOOK_URL=http://n8n:5678/webhook/lando-events

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
