# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=lando
POSTGRES_PASSWORD=lando_secret
POSTGRES_DB=lando_db
DATABASE_URL=postgresql://lando:lando_secret@db:5432/lando_db

# ─── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# ─── API ─────────────────────────────────────────────────────────────────────
# Host-side port exposed by Docker (8001 avoids conflicts with other local services)
API_PORT=8001
ENVIRONMENT=development
SECRET_KEY=change-me-in-production

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
