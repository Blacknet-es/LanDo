# Copy to .env and adjust values for local development
DATABASE_URL=postgresql://lando:lando_secret@localhost:5432/lando_db
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
ENVIRONMENT=development
SECRET_KEY=dev-only-secret-key-change-in-production
# Use `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# and keep this key outside the database; required in production.
LLM_SECRETS_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lando-events
WEBHOOK_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
